{
  "name": "beyondagtest",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source agentic mobile app testing tool",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspace=packages/dashboard-server & npm run dev --workspace=packages/dashboard-web",
    "test": "npm run test --workspaces",
    "lint": "eslint packages/*/src/**/*.{ts,tsx}",
    "typecheck": "tsc --noEmit",
    "dashboard": "npm run dev --workspace=packages/dashboard-server",
    "cli": "node packages/cli/dist/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mobile-testing",
    "agentic",
    "react-native",
    "flutter",
    "swiftui",
    "kotlin",
    "android",
    "ios",
    "testing",
    "automation"
  ],
  "author": "HMKhan70",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hmkhan10/beyondagtest.git"
  }
}
