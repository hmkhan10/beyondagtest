{
  "name": "beyondagtest",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source agentic mobile app testing tool",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/dashboard/server",
    "packages/dashboard/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:core": "npm run build --workspace=packages/core",
    "build:cli": "npm run build --workspace=packages/cli",
    "build:server": "npm run build --workspace=packages/dashboard/server",
    "build:web": "npm run build --workspace=packages/dashboard/web",
    "dev": "npm run dev --workspace=packages/dashboard/server & npm run dev --workspace=packages/dashboard/web",
    "dashboard": "npm run dev --workspace=packages/dashboard/server",
    "dashboard:web": "npm run dev --workspace=packages/dashboard/web",
    "cli": "node packages/cli/dist/index.js",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mobile-testing",
    "agentic",
    "react-native",
    "flutter",
    "swiftui",
    "kotlin",
    "android",
    "ios",
    "testing",
    "automation"
  ],
  "author": "HMKhan70",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hmkhan10/beyondagtest.git"
  }
}
